rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['activeGroupId', 'groups', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['activeGroupId', 'groups', 'updatedAt'])
        && request.resource.data.activeGroupId is string
        && request.resource.data.activeGroupId.size() > 0
        && request.resource.data.activeGroupId.size() <= 80
        && request.resource.data.groups is list
        && request.resource.data.groups.size() >= 1
        && request.resource.data.groups.size() <= 50
        && request.resource.data.updatedAt is int
        && request.resource.data.updatedAt >= 0;

      // Permanent append-only audit log: cannot be modified or deleted by anyone
      match /activity/{activityId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.keys().hasAll(['id', 'type', 'summary', 'detail', 'category', 'amountPaise', 'createdAt'])
          && request.resource.data.keys().hasOnly(['id', 'type', 'summary', 'detail', 'category', 'amountPaise', 'createdAt'])
          && request.resource.data.id == activityId
          && request.resource.data.type is string
          && request.resource.data.type.size() > 0
          && request.resource.data.type.size() <= 40
          && request.resource.data.summary is string
          && request.resource.data.summary.size() > 0
          && request.resource.data.summary.size() <= 200
          && request.resource.data.detail is string
          && request.resource.data.detail.size() <= 300
          && request.resource.data.category is string
          && request.resource.data.category.size() > 0
          && request.resource.data.category.size() <= 32
          && (
            request.resource.data.amountPaise == null ||
            (
              request.resource.data.amountPaise is int &&
              request.resource.data.amountPaise >= 0 &&
              request.resource.data.amountPaise <= 1000000000
            )
          )
          && request.resource.data.createdAt is int
          && request.resource.data.createdAt >= 0;
        allow update, delete: if false;
      }
    }
  }
}
